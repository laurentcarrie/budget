<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row_sync" android:layout_width="24dp" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/row_date" android:background="@drawable/chip_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="#FF263238" android:layout_margin="2dp" />
        <TextView android:id="@+id/row_shop" android:background="@drawable/chip_shop"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="#FF263238" android:layout_margin="2dp" />
        <TextView android:id="@+id/row_amount" android:background="@drawable/chip_amount"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="#FF263238" android:layout_margin="2dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_line2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="24dp" android:visibility="gone">
        <TextView android:id="@+id/row_category" android:background="@drawable/chip_category"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="#FF263238" android:layout_margin="2dp" />
        <TextView android:id="@+id/row_description" android:background="@drawable/chip_description"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textColor="#FF263238" android:layout_margin="2dp" />
    </LinearLayout>
</LinearLayout>
